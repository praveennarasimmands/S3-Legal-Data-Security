{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "RuleOne",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::legal-documents-bucket",
                "arn:aws:s3:::legal-documents-bucket/*"
            ],
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": "Public_Ip_address/24"
                }
            }
        },
        {
            "Sid": "RuleTwo",
            "Effect": "Deny",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::legal-documents-bucket",
                "arn:aws:s3:::legal-documents-bucket/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "aws:PrincipalTag/Role": "legal_team"
                }
            }
        }
    ]
}
